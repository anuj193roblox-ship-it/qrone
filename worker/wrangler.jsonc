{
  // QrOne redirect Worker. Commands run from the project root with: npx wrangler <command> -c worker/wrangler.jsonc
  "name": "qrone-redirect",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  "observability": { "enabled": true },
  // The main site, linked from the "expired" page so an owner can sign in. Never taken from the request.
  "vars": { "SITE_ORIGIN": "https://qr-tool-site.qr-tool-spike.workers.dev" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qrone",
      // Created in Eastern North America (location hint "enam"), close to US-first customers.
      // A database ID is an identifier, not a secret: it is useless without your Cloudflare login.
      "database_id": "76fec044-889a-40d7-9274-13b4a8e446d8",
      "migrations_dir": "migrations"
    }
  ]
}
