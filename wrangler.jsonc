{
  // The QrOne site: static pages from ./dist, plus a Worker (app/src/index.js) for /api/*.
  "name": "qr-tool-site",
  "main": "app/src/index.js",
  "compatibility_date": "2026-11-24",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qrone",
      "database_id": "76fec044-889a-40d7-9274-13b4a8e446d8",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Where short links live until customers connect their own domains (roadmap phase G).
  "vars": {
    "REDIRECT_ORIGIN": "https://qrone-redirect.qr-tool-spike.workers.dev",
    // Dodo test mode. Switch to https://live.dodopayments.com only when going live (roadmap H5).
    "DODO_API_BASE": "https://test.dodopayments.com",
    // Product IDs from the Dodo dashboard (roadmap F1), one per purchase: "<current plan>-<new plan>".
    // IDs are not secret. The API key and webhook secret are, so they're set with `wrangler secret put`.
    "DODO_PRODUCTS": {}
  }
  // Real sign-in email (Resend), once the domain is verified there:
  //   add "MAIL_FROM": "QrOne <signin@yourdomain.com>" to "vars" above,
  //   and set the key as a secret, never here: npx.cmd wrangler secret put RESEND_API_KEY
}
